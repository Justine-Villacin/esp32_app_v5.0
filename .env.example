# Copy this file to .env for local testing, and set the same values in
# Vercel's Project Settings -> Environment Variables for your deployment.

# --- Security -----------------------------------------------------------
# Shared secret required in the "X-API-Key" header on POST /update and
# POST /api/control. Leave empty only for local/private (home-LAN) testing.
# REQUIRED before pointing a public *.vercel.app URL at real hardware.
SMARTGROW_API_KEY=

# --- Persistent storage ---------------------------------------------------
# Connection string for a Redis-compatible store, e.g. a Marketplace Redis
# integration on Vercel (Upstash Redis is the common choice; Vercel KV was
# retired and existing KV stores were migrated to Upstash Redis).
# Format: redis://default:<password>@<host>:<port>
# If left empty, SmartGrow uses in-memory storage instead. That's fine for
# local desktop mode, but on Vercel it means data resets on every cold
# start — set this before relying on the hosted dashboard.
REDIS_URL=

# --- Dev mode / live reload ------------------------------------------------
# "true" turns on the /dev/reload-stream endpoint and file-watcher-driven
# live reload. desktop.py enables this automatically for local development;
# leave it unset (or "false") on Vercel.
SMARTGROW_DEV_MODE=false
